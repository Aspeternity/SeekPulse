# B-stage opt-in Web-first control-plane image. NO GHCR image/tag is published.
# This image is independent from the existing V1.1 RC1 Bot/runtime image.
FROM python:3.11-alpine3.24@sha256:d9368b3a5ac59afea7b5d4f2e2aea0941dbf9fdee9c369c5bec00b98244bc929

ARG SEEKPULSE_BUILD_REVISION=unverified-b-development
LABEL org.opencontainers.image.title="SeekPulse Web-first B" \
      org.opencontainers.image.source="https://github.com/Aspeternity/SeekPulse" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.revision="${SEEKPULSE_BUILD_REVISION}" \
      org.opencontainers.image.description="Unreleased opt-in Web-first control-plane prototype"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HOME=/tmp \
    SEEKPULSE_DATA_DIR=/app/data \
    SEEKPULSE_WEB_PORT=8765

WORKDIR /app

# Consistent with independently validated V1.1 Alpine stable zlib pin.
RUN apk add --no-cache --upgrade 'zlib=1.3.2-r1' \
    && apk info -v | grep -Fx 'zlib-1.3.2-r1'

COPY requirements-web-first.txt ./
RUN python -m pip install --no-cache-dir --upgrade pip==26.2.1 \
    && python -m pip install --no-cache-dir -r requirements-web-first.txt \
    && python -m pip check \
    && python -m pip uninstall --yes pip \
    && python -c 'from importlib.util import find_spec; assert find_spec("pip") is None'

# Install ONLY the B control plane, not the Bot/worker/application runtime.
RUN mkdir -p /app/app /app/data
COPY app/instance_lock.py app/web_auth.py app/web_first.py \
     app/web_first_store.py app/web_first_main.py /app/app/
COPY app/web_first_ui/ /app/app/web_first_ui/

# A brand-new Docker named volume adopts the pre-created private directory
# ownership, without a root runtime entrypoint or chown on existing user data.
RUN chown 10001:10001 /app/data && chmod 0700 /app/data
USER 10001:10001

EXPOSE 8765
ENTRYPOINT ["python", "-m", "app.web_first_main"]
