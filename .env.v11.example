# EXAMPLE ONLY: copy to a private location and never commit filled credentials.
# This file is deliberately ignored by the Docker build context.
# The image DOES NOT EXIST until a separately approved GHCR publish.
SEEKPULSE_IMAGE=ghcr.io/aspeternity/seekpulse@sha256:REPLACE_WITH_APPROVED_DIGEST
# Choose an existing absolute data directory on the Docker host.
# e.g. /opt/docker/seekpulse/data or /volume1/docker/seekpulse/data
SEEKPULSE_DATA_DIR=/ABSOLUTE/PRIVATE/seekpulse/data
SEEKPULSE_UID=10001
SEEKPULSE_GID=10001
BOT_TOKEN=REPLACE_IN_PRIVATE_ENV
ALLOWED_USER_IDS=REPLACE_WITH_ADMIN_TELEGRAM_USER_ID
SEEKPULSE_ADMIN_TG_USER_ID=REPLACE_WITH_ADMIN_TELEGRAM_USER_ID
SEEKPULSE_WEB_PASSWORD_HASH=REPLACE_WITH_GENERATED_SCRYPT_HASH
SEEKPULSE_WEB_PORT=8765
LOG_LEVEL=INFO
# All three TG reader values must be configured together with an existing
# Telethon session file at an absolute path inside the persisted data volume.
SEEKPULSE_TG_API_ID=
SEEKPULSE_TG_API_HASH=
SEEKPULSE_TG_SESSION=
# Optional restricted Apprise HTTPS targets. Disabled until explicitly enabled.
SEEKPULSE_PUSH_BARK_PRIMARY=
SEEKPULSE_PUSH_NTFY_PRIMARY=
