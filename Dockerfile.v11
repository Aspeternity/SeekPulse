# Opt-in V1.1 image: build-only until a separate GHCR publishing approval.
# Do not modify the legacy Dockerfile or its default app.main entrypoint.
# Docker-08 opt-in official Python 3.11 Alpine 3.24 multiarch index.
# Verified full-app candidate on native amd64+arm64 in Docker-07.
# This is a BASE index digest, NOT a published SeekPulse GHCR digest.
# Docker-08 base was separately accepted and merged. Docker-10 changes only
# pinned Alpine 3.24 stable zlib and V1.1 Python security dependencies.
# This remains non-published until separate user approval.
FROM python:3.11-alpine3.24@sha256:d9368b3a5ac59afea7b5d4f2e2aea0941dbf9fdee9c369c5bec00b98244bc929

# Offline CI uses 0.0.0-ci; a real version/tag needs a separate approval.
# Labels are traceability only; they are NOT a GHCR release or digest.
ARG SEEKPULSE_BUILD_VERSION=0.0.0-ci
ARG SEEKPULSE_BUILD_REVISION=unknown
LABEL org.opencontainers.image.title="SeekPulse" \
      org.opencontainers.image.description="SeekPulse opt-in V1.1 Docker runtime" \
      org.opencontainers.image.source="https://github.com/Aspeternity/SeekPulse" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${SEEKPULSE_BUILD_VERSION}" \
      org.opencontainers.image.revision="${SEEKPULSE_BUILD_REVISION}"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HOME=/tmp

WORKDIR /app

# Pin zlib from Alpine 3.24 stable repositories only (never edge).
# Missing exact security build on either architecture MUST fail closed.
RUN apk add --no-cache --upgrade 'zlib=1.3.2-r1' \
    && apk info -v zlib | grep -Fx 'zlib-1.3.2-r1'

# Each -r file contains approved direct pins; S5 includes S4/S3/upstream.
# V1.1-only fixed-version security patches, applied in the same image layer.
COPY requirements.txt requirements-s3.txt requirements-s4.txt requirements-s5.txt \
     requirements-v11-security.txt ./
RUN python -m pip install --no-cache-dir --upgrade pip==26.2.1 \
    && python -m pip install --no-cache-dir -r requirements-s5.txt \
    && python -m pip install --no-cache-dir --upgrade -r requirements-v11-security.txt \
    && python -m pip check

COPY app ./app

# The image has no secrets or host data. A fresh bind volume must be writable
# by this numeric uid/gid; do not add a root entrypoint that chowns user data.
# Use already verified Alpine-compatible numeric nonroot identity.
# Never recursively chown any user-provided persistent bind mount.
RUN mkdir -p /app/data \
    && chown 10001:10001 /app/data \
    && chmod 0700 /app/data

USER 10001:10001

# The existing runner checks SEEKPULSE_V11_ENABLE=1 and an explicit Prime.
# It MUST fail closed when DB/credentials/cutover preconditions are missing.
ENTRYPOINT ["python", "-m", "app.v11_main"]
CMD ["--run"]
