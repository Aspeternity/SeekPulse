# Keep private configuration/data out of every Docker build context.
.git
.gitignore
.venv
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd
.DS_Store
.env
.env.*
!.env.example
**/.env
**/.env.*
data
data/
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
**/*.session
**/*.session-*
**/*.log
secrets
secrets/
backups
backups/
.terraform/
.ssh/
